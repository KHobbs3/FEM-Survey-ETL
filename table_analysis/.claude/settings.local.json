{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Read(./raw/**)",
      "Read(**/*.csv)",
      "Read(**/*.dta)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(less:*)",
      "WebFetch"
    ],
    "allow": [
      "Bash(python scripts/*)",
      "Bash(Rscript scripts/*)"
    ]
  }
}
